<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/ykapt/VistivoTV"
        version="1.3.13"
        viewmodes="maximized">

    <name>Vistivo TV</name>

    <description>Unofficial remote-first Samsung TV client for personal Immich servers.</description>

    <author href="https://github.com/Ex8k/VistivoTV">Vistivo TV</author>

    <icon src="icon.png"/>

    <content src="index.html"/>

    <feature name="http://tizen.org/feature/screen.size.all"/>
    <feature name="http://tizen.org/feature/tv.inputdevice"/>

    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>

    <access origin="*" subdomains="true"/>

    <tizen:content-security-policy>default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; media-src http: https: blob:; connect-src http: https:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'</tizen:content-security-policy>

    <tizen:application
        id="Ldpj5lV8v1.VistivoTV"
        package="Ldpj5lV8v1"
        required_version="8.0"/>

    <tizen:profile name="tv-samsung"/>

    <tizen:setting
        screen-orientation="landscape"
        context-menu="disable"
        background-support="disable"
        encryption="disable"
        install-location="auto"
        hwkey-event="enable"/>

</widget>
